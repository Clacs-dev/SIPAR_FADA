{
  "name": "sipar20-backend",
  "version": "1.0.0",
  "description": "Backend Express para o projeto SIPAR20",
  "main": "dist/index.js",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc",
    "start": "node dist/index.js",
    "test": "npm run build && node --test \"dist/tests/*.test.js\"",
    "test:rules": "npm run build && node --test \"dist/tests/business-rules.test.js\"",
    "db:migrate:dev": "prisma migrate dev",
    "db:migrate:prod": "prisma migrate deploy",
    "db:studio": "prisma studio",
    "db:seed": "ts-node prisma/seed.ts"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.131.0",
    "@prisma/client": "^5.10.2",
    "@types/web-push": "^3.6.4",
    "bcryptjs": "^2.4.3",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "exceljs": "^4.4.0",
    "express": "^4.18.3",
    "express-rate-limit": "^7.2.0",
    "helmet": "^7.1.0",
    "hpp": "^0.2.3",
    "jsonwebtoken": "^9.0.2",
    "morgan": "^1.12.1",
    "multer": "^2.4.0",
    "node-machine-id": "^1.1.12",
    "nodemailer": "^10.0.15",
    "undici": "^7.30.0",
    "unpdf": "^1.8.1",
    "web-push": "^3.6.7",
    "winston": "^3.12.0",
    "zod": "^3.22.4"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/jsonwebtoken": "^9.0.6",
    "@types/morgan": "^1.9.9",
    "@types/multer": "^1.4.11",
    "@types/node": "^20.11.24",
    "@types/nodemailer": "^8.0.0",
    "prisma": "^5.10.2",
    "ts-node": "^10.9.2",
    "tsx": "^4.20.0",
    "typescript": "^5.3.3"
  },
  "engines": {
    "node": ">=20.18.1"
  },
  "overrides": {
    "qs": "^6.16.0",
    "uuid": "^11.1.1",
    "brace-expansion@1": "^1.1.21"
  }
}
