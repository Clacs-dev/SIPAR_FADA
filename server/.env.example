# Ver docs/developer/configuration-environment.md para a tabela completa
# (obrigatoriedade, finalidade, exemplo) de todas estas variaveis.

# ---- Nucleo ----
PORT=5000
DATABASE_URL="file:./dev.db"
NODE_ENV="development"

# Gere valores aleatorios proprios (nao reutilizar entre instalacoes). Ex.: openssl rand -hex 32
JWT_SECRET="defina-um-segredo-aleatorio-proprio-aqui"
JWT_REFRESH_SECRET="defina-outro-segredo-aleatorio-proprio-aqui"

# Endereco real onde o CLIENTE (Tauri) e servido/roda, na rede da instalacao.
# Em producao, pelo menos uma destas duas tem de estar definida ou o servidor
# recusa arrancar (parseAllowedOrigins em src/index.ts).
FRONTEND_URL="http://localhost:5173"
CORS_ORIGINS="http://localhost:5173,http://localhost:3000"

# ---- Licenciamento ----
# URL estatico (opcional) onde o vendor publica a CRL assinada
# (license-tools/generate-crl.js). A consulta e sempre best-effort: se nao
# estiver definido ou a instalacao estiver offline, o licenciamento continua a
# funcionar normalmente a partir da licenca/certificado ja ativados.
LICENSE_CRL_URL=""

# ---- E-mail (opcional — sem isto, o envio de e-mail fica apenas em log) ----
# Opcao A: SMTP direto (tem prioridade sobre Gmail se definido)
SMTP_HOST=""
SMTP_PORT=""
SMTP_USER=""
SMTP_PASS=""
# Opcao B: conta Gmail (usada so se SMTP_* acima estiver vazio)
GMAIL_USER=""
GMAIL_APP_PASSWORD=""
EMAIL_FROM=""

# ---- Notificacoes Push (Web Push / VAPID) — opcional ----
VAPID_PUBLIC_KEY=""
VAPID_PRIVATE_KEY=""
VAPID_SUBJECT=""

# ---- Integracoes de reuniao (opcional, sem UI de admin) ----
MEETING_DEFAULT_LINK=""
MEETING_TIMEZONE="Africa/Luanda"
# Google Meet
MEETING_GOOGLEMEET_DEFAULT_LINK=""
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""
GOOGLE_REFRESH_TOKEN=""
GOOGLE_CALENDAR_ID=""
# Zoom
MEETING_ZOOM_DEFAULT_LINK=""
ZOOM_ACCOUNT_ID=""
ZOOM_CLIENT_ID=""
ZOOM_CLIENT_SECRET=""
# Microsoft Teams
MEETING_TEAMS_DEFAULT_LINK=""
MICROSOFT_TENANT_ID=""
MICROSOFT_CLIENT_ID=""
MICROSOFT_CLIENT_SECRET=""
MICROSOFT_USER_ID=""

# Consulta de NIF à AGT (Portal do Contribuinte) - ver server/src/services/nif-lookup.service.ts.
# So define como "true" se o fetch nativo do Node falhar a verificar o
# certificado TLS do portal da AGT neste servidor ("unable to verify the
# first certificate" - problema conhecido em infraestrutura .gov.ao). Fica
# desligado (seguro) por omissao; afecta so este pedido especifico, nunca o
# resto do sistema.
AGT_TLS_INSECURE="false"

# ---- NAO USADO — mantido so por compatibilidade historica ----
# Declarada aqui mas sem nenhuma referencia em server/src (confirmado por
# pesquisa exaustiva). Nao tem efeito nenhum se definida.
SENDGRID_API_KEY=""
