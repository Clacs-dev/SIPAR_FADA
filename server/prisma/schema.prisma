datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

model User {
  id           String    @id @default(uuid())
  email        String    @unique
  password     String
  name         String
  role         String
  organization String?
  phone        String?
  department   String?
  departmentId String?
  areaId       String?
  position     String?
  address      String?
  document     String?
  status       String    @default("active")
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
  lastLogin    DateTime?

  // Coordenadas bancarias reutilizaveis (fornecedores/utilizadores externos)
  bankName          String?
  bankAccountHolder String?
  bankIban          String?
  bankNib           String?
  bankSwift         String?
  bankCity          String?
  bankCountry       String?
  // Varias coordenadas bancarias guardadas (fornecedor externo escolhe qual
  // usar em cada factura) - JSON: Array<{ id, label, bankName,
  // bankAccountHolder, bankIban, bankNib, bankSwift, bankCity, bankCountry }>.
  // Os campos bank* simples acima continuam a representar "a activa", lida
  // por todo o resto do sistema (ex: Ordem de Pagamento).
  bankAccounts      String    @default("[]")

  // Assinatura digitalizada (Presidente/Administrador) para Ordens de Pagamento
  signatureImage    String?

  organizedMeetings     InternalMeeting[] @relation("Organizer")
  participatedMeetings  InternalMeeting[] @relation("Participant")
  meetingParticipations InternalMeetingParticipant[]

  departmentRef  Department? @relation(fields: [departmentId], references: [id], onDelete: SetNull)
  areaRef        Area?       @relation(fields: [areaId], references: [id], onDelete: SetNull)
  presentations  Presentation[]
  audiences      Audience[]
  pedidos        Pedido[]
  actas          Acta[]
  oficios        Oficio[]
  facturas       Factura[]
  internalPaymentOrders InternalPaymentOrder[]
  viaturas       Viatura[]
  contratos      Contrato[]
  reclamacoes    Reclamacao[]
  fornecedores   Fornecedor[]
  procurementCategorias ProcurementCategoria[]
  planejamentos  Planejamento[]
  procurements   Procurement[]
  operadores     Operador[]
  comunicacoes   Comunicacao[]
  pedidoViaturas PedidoViatura[]
  utilizacoesViatura UtilizacaoViatura[]
  manutencoesViatura ManutencaoViatura[]
  auditLogs      AuditLog[]
  notifications  Notification[]
  uploadedFiles  UploadedFile[]
  sentMessages   Message[] @relation("MessageFrom")
  receivedMessages Message[] @relation("MessageTo")
  pushSubscriptions PushSubscription[]
  passwordResetTokens PasswordResetToken[]
  sessions UserSession[]
  purchaseOrdersCreated PurchaseOrder[]
  budgetsCreated Budget[]
  budgetExecutionsCreated BudgetExecution[]
  accountsPayableCreated AccountPayable[]
  accountsReceivableCreated AccountReceivable[]
  financialReportsCreated FinancialReport[]

  @@index([departmentId])
  @@index([areaId])
}

model Department {
  id        String   @id @default(uuid())
  nome      String
  slug      String   @unique
  categoria String?
  descricao String?
  cor       String?
  activo    Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  deletedAt     DateTime?
  deletedById   String?
  deletedByName String?

  users User[]
  areas Area[]
}

model Role {
  id        String   @id @default(uuid())
  slug      String   @unique
  nome      String
  descricao String?
  sistema   Boolean  @default(false)
  // Marca roles de gabinete/executivo (isAdminUser em middlewares/auth.ts).
  // Substitui o array fixo de strings que existia antes - criar um role novo
  // e marcar este campo concede automaticamente o nivel de acesso "admin
  // executivo" (usado por requireAdmin), sem tocar em codigo.
  executivo Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  deletedAt     DateTime?
  deletedById   String?
  deletedByName String?

  permissoes RolePermission[]
}

// Subdivisao dentro de um departamento (ex: uma equipa/unidade). Introduzida
// junto com o resto do admin_sistema (Departamentos, Roles, Lixeira, etc.)
// portado do SIPAR_MINTRANS.
model Area {
  id            String    @id @default(uuid())
  nome          String
  slug          String
  departmentId  String
  descricao     String?
  activo        Boolean   @default(true)
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  deletedAt     DateTime?
  deletedById   String?
  deletedByName String?

  department Department @relation(fields: [departmentId], references: [id], onDelete: Cascade)
  users      User[]

  @@unique([departmentId, slug])
  @@index([departmentId])
}

model RolePermission {
  id        String   @id @default(uuid())
  roleId    String
  module    String
  action    String
  createdAt DateTime @default(now())

  role Role @relation(fields: [roleId], references: [id], onDelete: Cascade)

  @@unique([roleId, module, action])
  @@index([roleId])
}

model InternalMeeting {
  id            String   @id @default(uuid())
  organizerId   String
  participantId String?
  title         String
  description   String?
  meetingDate   String
  startTime     String
  endTime       String
  meetingType   String
  location      String?
  platform      String?
  meetingLink   String?
  priority      String   @default("normal")
  status        String   @default("pendente")
  tipoReuniao   String   @default("ordinaria")
  orgao         String?
  pontosAgenda  String   @default("[]")
  roomId        String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  organizer     User                         @relation("Organizer", fields: [organizerId], references: [id], onDelete: Cascade)
  participant   User?                        @relation("Participant", fields: [participantId], references: [id], onDelete: SetNull)
  room          MeetingRoom?                 @relation(fields: [roomId], references: [id], onDelete: SetNull)
  participantes InternalMeetingParticipant[]
  actas         Acta[]

  @@index([roomId, meetingDate])
}

model MeetingRoom {
  id          String   @id @default(uuid())
  nome        String
  capacidade  Int      @default(0)
  localizacao String?
  recursos    String   @default("[]")
  ativa       Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  meetings InternalMeeting[]
}

model InternalMeetingParticipant {
  id        String   @id @default(uuid())
  meetingId String
  userId    String?
  name      String
  email     String?
  role      String?
  cargo     String?
  department String?
  presente  Boolean  @default(false)
  data      String   @default("{}")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  meeting InternalMeeting @relation(fields: [meetingId], references: [id], onDelete: Cascade)
  user    User?           @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([meetingId])
}

model Presentation {
  id            String   @id
  createdById   String?
  createdByName String?
  status        String   @default("pendente")
  company       String?
  nif           String?
  purpose       String?
  department    String?
  desiredDate   String?
  contactName   String?
  contactEmail  String?
  contactPhone  String?
  data          String   @default("{}")
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  deletedAt     DateTime?
  deletedById   String?
  deletedByName String?

  createdBy User? @relation(fields: [createdById], references: [id], onDelete: SetNull)

  @@index([createdById])
}

model Audience {
  id             String   @id
  createdById    String?
  createdByName  String?
  status         String   @default("pendente")
  requestorName  String?
  requestorEmail String?
  requestorPhone String?
  organization   String?
  nif            String?
  purpose        String?
  department     String?
  desiredDate    String?
  participants   Int?
  data           String   @default("{}")
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
  deletedAt      DateTime?
  deletedById    String?
  deletedByName  String?

  createdBy User? @relation(fields: [createdById], references: [id], onDelete: SetNull)

  @@index([createdById])
}

model Pedido {
  id              String    @id
  numero          String?   @unique
  createdById     String?
  createdByName   String?
  titulo          String
  descricao       String
  importancia     String
  categoria       String?
  direcao         String?
  funcao          String?
  status          String    @default("pendente")
  atribuidoAId    String?
  atribuidoANome  String?
  abertoEm        DateTime?
  resolvidoEm     DateTime?
  fechadoEm       DateTime?
  solucao         String?
  anexos          String    @default("[]")
  data            String    @default("{}")
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  createdBy User? @relation(fields: [createdById], references: [id], onDelete: SetNull)

  @@index([createdById])
}

model Acta {
  id                String   @id
  numero            String?
  createdById        String?
  createdByName      String?
  internalMeetingId  String?
  status            String   @default("rascunho")
  assunto           String?
  dataReuniao       String?
  horaInicio        String?
  horaFim           String?
  local             String?
  tipoReuniao       String?
  modalidade        String?
  departamento      String?
  conteudo          String?
  decisoes          String?
  participantes     String   @default("[]")
  pontosAgenda      String   @default("[]")
  anexos            String   @default("[]")
  data              String   @default("{}")
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt
  deletedAt         DateTime?
  deletedById       String?
  deletedByName     String?

  createdBy       User?            @relation(fields: [createdById], references: [id], onDelete: SetNull)
  internalMeeting InternalMeeting? @relation(fields: [internalMeetingId], references: [id], onDelete: SetNull)

  @@index([createdById])
}

model Oficio {
  id            String   @id
  createdById   String?
  createdByName String?
  status        String   @default("pendente")
  numero        String?
  assunto       String?
  destinatario  String?
  departamento  String?
  prioridade    String?
  conteudo      String?
  anexos        String   @default("[]")
  data          String   @default("{}")
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  createdBy User? @relation(fields: [createdById], references: [id], onDelete: SetNull)

  @@index([createdById])
}

model Factura {
  id            String    @id
  createdById   String?
  createdByName String?
  status        String    @default("pendente")
  numero        String?
  fornecedor    String?
  nif           String?
  valor         Float?
  moeda         String?
  dataEmissao   String?
  dataVencimento String?
  descricao     String?
  anexos        String    @default("[]")
  paidAt        DateTime?
  purchaseOrderId String?  // Vinculo com a Ordem de Compra do Procurement (sincronizacao)
  numeroOrdem     String?
  numeroOrdemPagamento String?  // N.o da Ordem de Pagamento gerada (ex: OP/N.o 1261/2026)
  data          String    @default("{}")
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  deletedAt     DateTime?
  deletedById   String?
  deletedByName String?

  createdBy User? @relation(fields: [createdById], references: [id], onDelete: SetNull)

  @@index([createdById])

  @@index([purchaseOrderId])
}

// Ordem de Pagamento Interna: mesma finalidade e o mesmo PDF final da Ordem
// de Pagamento a Fornecedor (ver numeroOrdemPagamento em Factura), mas
// preenchida manualmente pelo utilizador em vez de gerada automaticamente a
// partir de uma factura aprovada - por isso e uma entidade propria, nao um
// campo dentro de Factura.
model InternalPaymentOrder {
  id             String    @id @default(uuid())
  numero         String    @unique
  status         String    @default("rascunho") // rascunho -> assinado (ambas as assinaturas) -> submetido_ao_banco -> pago
  descricao      String
  valor          Float
  moeda          String    @default("AOA")
  destinatario   String    // "A favor de" - pode ser pessoa, departamento ou entidade interna
  numeroDespacho String?
  contaDebito    String?
  bancoNome      String?
  bancoIban      String?
  bancoCidade    String?
  bancoPais      String?
  paidAt         DateTime?
  data           String    @default("{}") // assinaturas (mesmo formato da Ordem de Pagamento a Fornecedor)
  createdById    String?
  createdByName  String?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  createdBy User? @relation(fields: [createdById], references: [id], onDelete: SetNull)

  @@index([createdById])
}

model Viatura {
  id            String   @id
  createdById   String?
  createdByName String?
  status        String   @default("disponivel")
  plate         String?
  brand         String?
  model         String?
  year          Int?
  type          String?
  currentKm     Int?
  assignedTo    String?
  anexos        String   @default("[]")
  data          String   @default("{}")
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  createdBy User? @relation(fields: [createdById], references: [id], onDelete: SetNull)

  @@index([createdById])
}

model Contrato {
  id            String   @id
  createdById   String?
  createdByName String?
  status        String   @default("pendente")
  numero        String?
  fornecedor    String?
  objeto        String?
  valor         Float?
  dataInicio    String?
  dataFim       String?
  anexos        String   @default("[]")
  data          String   @default("{}")
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  createdBy User? @relation(fields: [createdById], references: [id], onDelete: SetNull)

  @@index([createdById])
}

model Reclamacao {
  id            String   @id
  createdById   String?
  createdByName String?
  status        String   @default("pendente")
  codigo        String?
  titulo        String?
  descricao     String?
  categoria     String?
  prioridade    String?
  solicitante   String?
  contacto      String?
  anexos        String   @default("[]")
  data          String   @default("{}")
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  createdBy User? @relation(fields: [createdById], references: [id], onDelete: SetNull)

  @@index([createdById])
}

model Fornecedor {
  id            String   @id
  createdById   String?
  createdByName String?
  status        String   @default("active")
  nome          String?
  email         String?
  nif           String?
  telefone      String?
  endereco      String?
  userId        String?  // Conta de utilizador (role externo) ligada, usada para submeter facturas/cotacoes
  data          String   @default("{}")
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  deletedAt     DateTime?
  deletedById   String?
  deletedByName String?

  createdBy User? @relation(fields: [createdById], references: [id], onDelete: SetNull)
  purchaseQuotations PurchaseQuotation[]
  purchaseOrders PurchaseOrder[]
  procurementsAsFornecedor Procurement[]

  @@index([createdById])
}

// Categorias de produtos/servicos usadas tanto no cadastro de fornecedores
// (que categorias cada fornecedor fornece) como na criacao de um pedido de
// compra (que categoria esta a ser adquirida). Comecou como uma lista fixa no
// front-end; agora e' gerida aqui para que o utilizador possa criar novas
// categorias directamente a partir do formulario de fornecedor.
model ProcurementCategoria {
  id          String   @id
  nome        String   @unique
  createdById String?
  createdAt   DateTime @default(now())

  createdBy User? @relation(fields: [createdById], references: [id], onDelete: SetNull)

  @@index([createdById])
}

model Planejamento {
  id            String   @id
  createdById   String?
  createdByName String?
  status        String   @default("pendente")
  tipo          String?
  titulo        String?
  descricao     String?
  valor         Float?
  dataInicio    String?
  dataFim       String?
  data          String   @default("{}")
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  createdBy User? @relation(fields: [createdById], references: [id], onDelete: SetNull)

  @@index([createdById])
}

model Procurement {
  id            String   @id
  createdById   String?
  createdByName String?
  status        String   @default("pendente")
  tipo          String?
  numero        String?
  fornecedorId  String?
  fornecedor    String?
  valor         Float?
  descricao     String?
  data          String   @default("{}")
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  deletedAt     DateTime?
  deletedById   String?
  deletedByName String?

  createdBy User? @relation(fields: [createdById], references: [id], onDelete: SetNull)
  fornecedorRef Fornecedor? @relation(fields: [fornecedorId], references: [id], onDelete: SetNull)
  purchaseQuotations PurchaseQuotation[]
  purchaseOrders PurchaseOrder[]

  @@index([createdById])
  @@index([fornecedorId])
}

model Operador {
  id            String   @id
  createdById   String?
  createdByName String?
  status        String   @default("active")
  nome          String?
  email         String?
  telefone      String?
  area          String?
  data          String   @default("{}")
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  createdBy User? @relation(fields: [createdById], references: [id], onDelete: SetNull)

  @@index([createdById])
}

model Comunicacao {
  id            String   @id
  createdById   String?
  createdByName String?
  status        String   @default("pendente")
  titulo        String?
  assunto       String?
  mensagem      String?
  destinatarios String   @default("[]")
  prioridade    String?
  anexos        String   @default("[]")
  data          String   @default("{}")
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  deletedAt     DateTime?
  deletedById   String?
  deletedByName String?

  createdBy User? @relation(fields: [createdById], references: [id], onDelete: SetNull)

  @@index([createdById])
}

model PedidoViatura {
  id            String   @id
  createdById   String?
  createdByName String?
  status        String   @default("pendente")
  viaturaId     String?
  motivo        String?
  destino       String?
  dataInicio    String?
  dataFim       String?
  anexos        String   @default("[]")
  data          String   @default("{}")
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  createdBy User? @relation(fields: [createdById], references: [id], onDelete: SetNull)

  @@index([createdById])
}

model UtilizacaoViatura {
  id            String   @id
  createdById   String?
  createdByName String?
  status        String   @default("em_curso")
  viaturaId     String?
  motorista     String?
  destino       String?
  motivo        String?
  dataInicio    String?
  dataFim       String?
  kmInicio      Int?
  kmFim         Int?
  anexos        String   @default("[]")
  data          String   @default("{}")
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  createdBy User? @relation(fields: [createdById], references: [id], onDelete: SetNull)

  @@index([createdById])
}

model ManutencaoViatura {
  id            String   @id
  createdById   String?
  createdByName String?
  status        String   @default("pendente")
  viaturaId     String?
  tipo          String?
  descricao     String?
  fornecedor    String?
  valor         Float?
  dataInicio    String?
  dataFim       String?
  anexos        String   @default("[]")
  data          String   @default("{}")
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  createdBy User? @relation(fields: [createdById], references: [id], onDelete: SetNull)

  @@index([createdById])
}

model UploadedFile {
  id           String   @id
  userId       String?
  originalName String
  filename     String
  path         String
  url          String
  mimetype     String
  size         Int
  module       String?
  resourceId   String?
  createdAt    DateTime @default(now())

  user User? @relation(fields: [userId], references: [id], onDelete: SetNull)
}

model Notification {
  id         String   @id
  userId     String?
  email      String
  type       String
  resourceId String?
  status     String?
  message    String
  read       Boolean  @default(false)
  metadata   String   @default("{}")
  createdAt  DateTime @default(now())

  user User? @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([userId])
  @@index([email])
}

model AuditLog {
  id           String   @id
  userId       String?
  userEmail    String?
  userRole     String?
  action       String
  severity     String   @default("info")
  resource     String?
  resourceId   String?
  ipAddress    String?
  userAgent    String?
  success      Boolean?
  errorMessage String?
  metadata     String   @default("{}")
  oldValue     String?
  newValue     String?
  resolved       Boolean   @default(false)
  resolvedById   String?
  resolvedByName String?
  resolvedAt     DateTime?
  createdAt    DateTime @default(now())

  user User? @relation(fields: [userId], references: [id], onDelete: SetNull)
}

model UserSession {
  id               String    @id @default(uuid())
  userId           String
  refreshTokenHash String    @unique
  userAgent        String?
  ipAddress        String?
  createdAt        DateTime  @default(now())
  expiresAt        DateTime
  revokedAt        DateTime?
  revokedReason    String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model PasswordResetToken {
  id        String    @id @default(uuid())
  userId    String
  tokenHash String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model SystemSetting {
  key           String   @id
  value         String
  updatedAt     DateTime @updatedAt
  updatedById   String?
  updatedByName String?
}

model License {
  id                       String    @id @default(uuid())
  licenseId                String    @unique
  customerName              String
  licenseType               String
  status                     String    @default("pending")
  startsAt                  DateTime
  expiresAt                 DateTime?
  maxUsers                  Int?
  maxAdmins                 Int?
  modules                   String    @default("[]")
  features                  String    @default("{}")
  offlineGraceDays           Int       @default(7)
  minVersion                 String?
  issuedAt                   DateTime
  signedPayload               String
  signature                   String
  activationCertPayload       String?
  activationCertSignature     String?
  installationFingerprint     String?
  activatedAt                 DateTime?
  lastValidatedAt              DateTime?
  createdAt                   DateTime  @default(now())
  updatedAt                   DateTime  @updatedAt
}

model Message {
  id            String   @id @default(uuid())
  fromUserId    String
  toUserId      String
  subject       String
  content       String
  messageType   String   @default("internal")
  priority      String   @default("medium")
  status        String   @default("unread")
  relatedToType String?
  relatedToId   String?
  readAt        DateTime?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  fromUser User @relation("MessageFrom", fields: [fromUserId], references: [id], onDelete: Cascade)
  toUser   User @relation("MessageTo", fields: [toUserId], references: [id], onDelete: Cascade)

  @@index([fromUserId])
  @@index([toUserId])
}

model DocumentSequence {
  id        String   @id @default(uuid())
  module    String
  year      Int
  month     Int      @default(0)
  prefix    String
  current   Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([module, year, month, prefix])
}

model DocumentHistory {
  id             String   @id @default(uuid())
  module         String
  resourceId     String
  action         String
  statusFrom     String?
  statusTo       String?
  userId         String?
  userName       String?
  userEmail      String?
  userRole       String?
  comment        String?
  metadata       String   @default("{}")
  oldValue       String?
  newValue       String?
  createdAt      DateTime @default(now())

  @@index([module, resourceId])
}

model ApprovalWorkflow {
  id             String   @id @default(uuid())
  module         String
  resourceId     String
  status         String   @default("pending")
  currentLevel   Int      @default(1)
  totalLevels    Int      @default(1)
  requestedById  String?
  requestedByName String?
  requestedAt    DateTime @default(now())
  completedAt    DateTime?
  metadata       String   @default("{}")
  steps          ApprovalStep[]

  @@index([module, resourceId])
}

model ApprovalStep {
  id             String   @id @default(uuid())
  workflowId     String
  level          Int
  status         String   @default("pending")
  approverId     String?
  approverName   String?
  approverEmail  String?
  approverRole   String?
  decision       String?
  comment        String?
  decidedAt      DateTime?
  metadata       String   @default("{}")
  createdAt      DateTime @default(now())

  workflow ApprovalWorkflow @relation(fields: [workflowId], references: [id], onDelete: Cascade)

  @@index([workflowId, level])
}

model ValidationRule {
  id             String   @id @default(uuid())
  module         String
  status         String?
  field          String
  required       Boolean  @default(true)
  message        String?
  active         Boolean  @default(true)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@index([module, status])
}

model PushSubscription {
  id        String   @id @default(uuid())
  userId    String?
  endpoint  String   @unique
  auth      String
  p256dh     String
  userAgent String?
  active    Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user User? @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([userId])
}

model PurchaseQuotation {
  id            String   @id @default(uuid())
  procurementId String?
  fornecedorId  String?
  fornecedor    String
  email         String?
  valor         Float
  moeda         String   @default("AOA")
  prazoEntrega  String?
  validade      String?
  status        String   @default("recebida")
  selected      Boolean  @default(false)
  anexos        String   @default("[]")
  data          String   @default("{}")
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  procurement   Procurement? @relation(fields: [procurementId], references: [id], onDelete: SetNull)
  fornecedorRef Fornecedor?  @relation(fields: [fornecedorId], references: [id], onDelete: SetNull)
  purchaseOrders PurchaseOrder[]

  @@index([procurementId])
  @@index([fornecedorId])
}

model PurchaseOrder {
  id            String   @id @default(uuid())
  numero        String?  @unique
  procurementId String?
  quotationId   String?
  fornecedorId  String?
  fornecedor    String
  valor         Float
  moeda         String   @default("AOA")
  status        String   @default("emitida")
  prazoEntrega  String?
  localEntrega  String?
  recebidoEm    DateTime?
  recebidoPorId String?
  recebidoPorNome String?
  itens         String   @default("[]")
  anexos        String   @default("[]")
  data          String   @default("{}")
  createdById   String?
  createdByName String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  createdBy     User?               @relation(fields: [createdById], references: [id], onDelete: SetNull)
  procurement   Procurement?        @relation(fields: [procurementId], references: [id], onDelete: SetNull)
  quotation     PurchaseQuotation?  @relation(fields: [quotationId], references: [id], onDelete: SetNull)
  fornecedorRef Fornecedor?         @relation(fields: [fornecedorId], references: [id], onDelete: SetNull)

  @@index([procurementId])
  @@index([quotationId])
  @@index([fornecedorId])
  @@index([createdById])
}

model Budget {
  id            String   @id @default(uuid())
  numero        String?  @unique
  ano           Int
  periodo       String   @default("anual")
  department    String?
  titulo        String
  status        String   @default("rascunho")
  totalOrcado   Float    @default(0)
  totalComprometido Float @default(0)
  totalRealizado Float   @default(0)
  data          String   @default("{}")
  createdById   String?
  createdByName String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  lines      BudgetLine[]
  executions BudgetExecution[]
  createdBy  User? @relation(fields: [createdById], references: [id], onDelete: SetNull)

  @@index([createdById])
}

model BudgetLine {
  id            String   @id @default(uuid())
  budgetId      String
  categoria     String
  subcategoria  String?
  descricao     String?
  valorOrcado   Float
  valorComprometido Float @default(0)
  valorRealizado Float   @default(0)
  data          String   @default("{}")
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  budget Budget @relation(fields: [budgetId], references: [id], onDelete: Cascade)
  executions BudgetExecution[]

  @@index([budgetId])
}

model BudgetExecution {
  id            String   @id @default(uuid())
  budgetId      String
  budgetLineId  String?
  tipo          String   @default("realizado")
  valor         Float
  descricao     String?
  origemModulo  String?
  origemId      String?
  dataMovimento String
  createdById   String?
  createdByName String?
  data          String   @default("{}")
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  budget Budget @relation(fields: [budgetId], references: [id], onDelete: Cascade)
  budgetLine BudgetLine? @relation(fields: [budgetLineId], references: [id], onDelete: SetNull)
  createdBy  User? @relation(fields: [createdById], references: [id], onDelete: SetNull)

  @@index([budgetId])
  @@index([budgetLineId])
  @@index([createdById])
}

model AccountPayable {
  id            String   @id @default(uuid())
  numero        String?  @unique
  fornecedor    String
  descricao     String
  valor         Float
  moeda         String   @default("AOA")
  dataVencimento String
  status        String   @default("pendente")
  pagoEm        DateTime?
  origemModulo  String?
  origemId      String?
  data          String   @default("{}")
  createdById   String?
  createdByName String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  createdBy User? @relation(fields: [createdById], references: [id], onDelete: SetNull)

  @@index([createdById])
}

model AccountReceivable {
  id            String   @id @default(uuid())
  numero        String?  @unique
  cliente       String
  descricao     String
  valor         Float
  moeda         String   @default("AOA")
  dataVencimento String
  status        String   @default("pendente")
  recebidoEm    DateTime?
  origemModulo  String?
  origemId      String?
  data          String   @default("{}")
  createdById   String?
  createdByName String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  createdBy User? @relation(fields: [createdById], references: [id], onDelete: SetNull)

  @@index([createdById])
}

model FinancialReport {
  id            String   @id @default(uuid())
  tipo          String
  periodoInicio String?
  periodoFim    String?
  department    String?
  status        String   @default("gerado")
  payload       String   @default("{}")
  createdById   String?
  createdByName String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  createdBy User? @relation(fields: [createdById], references: [id], onDelete: SetNull)

  @@index([createdById])
}
